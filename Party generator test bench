

module parity_generator_tb;

reg d1, d2, d3;
wire parity;

parity_generator uut(
    .d1(d1),
    .d2(d2),
    .d3(d3),
    .parity(parity)
);

initial begin

    d1=0; d2=0; d3=0;
    #10;

    d1=0; d2=1; d3=0;
    #10;

    d1=1; d2=0; d3=1;
    #10;

    d1=1; d2=1; d3=1;
    #10;

    $finish;
end

endmodule
